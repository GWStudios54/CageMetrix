    "data:bootstrap": "node scripts/bootstrap.mjs",
    "ratings:recalibrate": "node scripts/recalibrate_v022.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "wrangler": "^4.102.0"
  }
}
