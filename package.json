{
  "name": "cagemetrix",
  "version": "0.3.0",
  "private": true,
  "description": "Opponent-adjusted MMA analytics",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "test": "node --test tests/*.test.mjs",
    "test:fights:e2e": "node scripts/test-fight-e2e.mjs",
    "snapshots:backfill": "node scripts/backfill-prediction-snapshots.mjs",
    "contributor": "node scripts/contributor.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:create": "wrangler d1 create cagemetrix",
    "db:migrate:local": "wrangler d1 migrations apply cagemetrix --local",
    "db:migrate:remote": "wrangler d1 migrations apply cagemetrix --remote",
    "data:bootstrap": "node scripts/refresh-data.mjs --remote",
    "ratings:recalibrate": "node scripts/refresh-data.mjs --remote",
    "data:refresh": "node scripts/refresh-data.mjs --remote",
    "data:sync-recent": "node scripts/sync-recent.mjs --fresh --remote",
    "forecasts:sync": "node scripts/sync-forecasts.mjs --remote",
    "model:validate": "node scripts/validate-model.mjs --stats .cache/refresh/stats.csv",
    "predictor:validate": "node scripts/validate-predictor.mjs --stats .cache/refresh/stats.csv --output .cache/predictor-validation.json",
    "cmr04:validate": "node scripts/validate-cmr-v04.mjs",
    "predictor011:validate": "node scripts/validate-predictor-v011.mjs --history .cache/cmr-v04-history.json",
    "predictor02:validate": "node scripts/validate-predictor-v02-style.mjs --stats .cache/refresh/stats.csv"
  },
  "devDependencies": {
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.102.0"
  }
}
