{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cagemetrix",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "routes": [
    {
      "pattern": "cagemetrix.com",
      "custom_domain": true
    },
    {
      "pattern": "www.cagemetrix.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fighters/*", "/fights/*"]
  },
  "vars": {
    "MODEL_VERSION": "0.3.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cagemetrix",
      "database_id": "d36f1b7e-a114-43a7-bbce-24053ed3e392",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
