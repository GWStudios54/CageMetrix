{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cagemetrix",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "MODEL_VERSION": "0.1.0"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cagemetrix",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
